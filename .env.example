# Variables para docker-compose.yml (local). Copiar a ".env" (sin
# versionar) y reemplazar todos los CAMBIAR_ESTE_VALOR antes de levantar
# los contenedores. Nunca comitear el ".env" real ni reusar estos
# placeholders como si fueran valores de verdad.

# ---- PostgreSQL (solo accesible dentro de la red interna de Docker) ----
POSTGRES_USER=CAMBIAR_ESTE_VALOR
# POSTGRES_PASSWORD debe ser HEXADECIMAL (ej. `openssl rand -hex 24`).
# Este valor se inserta tal cual dentro de la URL de conexión
# (DATABASE_URL, armada en docker-compose.yml) — caracteres como
# @ : / # ahí rompen el parseo de la URL. Hex evita el problema por
# completo porque solo usa [0-9a-f].
POSTGRES_PASSWORD=CAMBIAR_ESTE_VALOR
POSTGRES_DB=CAMBIAR_ESTE_VALOR

# ---- Caddy — dirección del sitio ----
# Local: dejar ":80" (o sin definir, el Caddyfile ya usa ":80" por
# defecto). Producción: dominio(s) reales separados por coma, ej.
# "app.estixa.com, admin.estixa.com" — Caddy obtiene/renueva HTTPS solo.
SITE_ADDRESS=:80

# ---- JWT — generar con, por ejemplo, `openssl rand -hex 32` ----
JWT_ACCESS_SECRET=CAMBIAR_ESTE_VALOR
JWT_REFRESH_SECRET=CAMBIAR_ESTE_VALOR
JWT_SUPERADMIN_SECRET=CAMBIAR_ESTE_VALOR
JWT_ACCESS_TTL=15m

# ---- App ----
PORT=3000
NODE_ENV=production
# En local, Caddy escucha en :80 sin dominio — el navegador llega por ahí.
ALLOWED_ORIGINS=http://localhost

# ---- WebAuthn — rpID/origin deben coincidir con el dominio real desde el
# que se abre el frontend (aquí, localhost sin puerto porque Caddy
# publica el :80). ----
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost
WEBAUTHN_RP_NAME=Estixa

# ---- URL del frontend (enlaces de correo, ej. "olvidé mi contraseña") ----
FRONTEND_URL=http://localhost

# ---- Correo (Resend) — vacío en local/staging = modo seguro: EmailService
# solo registra en el log, no envía nada real (ver auditoría de
# infraestructura, punto 3). ----
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
