# Base de datos (usar el pooler de Neon/Supabase en producción)
DATABASE_URL="postgresql://user:password@localhost:5432/estixa?schema=public"

# JWT — generar secrets fuertes y distintos (ej. openssl rand -hex 32)
JWT_ACCESS_SECRET="cambiar-en-produccion-access"
JWT_REFRESH_SECRET="cambiar-en-produccion-refresh"
JWT_SUPERADMIN_SECRET="cambiar-en-produccion-superadmin"
JWT_ACCESS_TTL="15m"

# App
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# WebAuthn (login biométrico) — rpID es el dominio exacto (sin esquema ni
# puerto) donde corre el frontend; expectedOrigin es esa misma URL completa.
# Para desarrollo local con `vite preview` (puerto 4173):
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:4173"
# Nombre que se muestra en el diálogo nativo de huella/Face ID del
# navegador — solo texto, no afecta el vínculo criptográfico de arriba.
WEBAUTHN_RP_NAME="Estixa"

# URL del frontend — arma el enlace de "restablecer contraseña" del correo.
FRONTEND_URL="http://localhost:4173"

# Resend (correo real de "olvidé mi contraseña") — API key propia de
# https://resend.com/api-keys. Sin esto configurado, el envío de correos
# falla de forma silenciosa (log de advertencia, no rompe el resto de la
# app) — ver README para más detalle.
RESEND_API_KEY=""
# Remitente de PRUEBA de Resend (onboarding@resend.dev) — funciona sin
# verificar dominio propio, pero solo entrega a la dirección con la que se
# creó la cuenta de Resend. Antes de producción real, verificar un dominio
# propio en Resend y cambiar esto a algo con la marca de Estixa.
EMAIL_FROM="onboarding@resend.dev"
