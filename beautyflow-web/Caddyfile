# Dirección del sitio desde la variable de entorno SITE_ADDRESS, con ":80"
# como valor por defecto si no está definida (sintaxis {$VAR:default} —
# verificada contra el binario real de Caddy: caddy validate, no de
# memoria). Admite varias direcciones separadas por coma, ej.
# "app.estixa.com, admin.estixa.com" — ahí Caddy obtiene/renueva el
# certificado HTTPS automáticamente (requiere persistir /data, ver
# docker-compose.yml). Local sigue funcionando en :80 (HTTP, sin TLS).
{$SITE_ADDRESS::80} {
	encode gzip

	# Mismo origen: todo lo que empiece con /api va al backend, sin tocar
	# el path (el backend ya espera el prefijo api/v1 completo).
	handle /api/* {
		reverse_proxy backend:3000
	}

	# El resto: estático de la SPA, con fallback a index.html para las
	# rutas de react-router que no existen como archivo físico.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
